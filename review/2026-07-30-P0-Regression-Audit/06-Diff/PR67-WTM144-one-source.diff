+      expect(
+        ids,
+        contains(o.customerId),
+        reason: 'mỗi đơn mẫu phải trỏ tới một khách mẫu tồn tại',
+      );
+    }
+  });
+
+  test(
+    're-seeding never duplicates (idempotent, incl. insert-only finance)',
+    () async {
