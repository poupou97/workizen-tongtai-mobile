+      // UUID ids — the ADR-TON-014 marker of user data. NOT `sample-` prefixed.
+      const userCustomerId = '7c9e6679-7425-40de-963d-e35b1566ac1f';
+      const userOrderId = 'b21f3d5c-9a44-4f7e-91aa-0f2c6d8e4b10';
